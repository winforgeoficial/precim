# Token do @BotFather. Vazio = bot e alertas desligados.
PRECIM_TELEGRAM_TOKEN=
# Seu chat id (mande /start ao bot para descobrir). Só este chat é atendido.
PRECIM_TELEGRAM_CHAT_ID=
# Minutos entre varreduras do Buscapé/Zoom (Kabum e Amazon: a cada 3 h). Aceita ciclo: 30,50,60
PRECIM_SCAN_CYCLE_MINUTES=60
# Coleta direta da Amazon por navegador (termos de uso da Amazon proíbem acesso automatizado)
PRECIM_AMAZON_ENABLED=true
# Opcional: caminho de um Chromium já instalado (no Docker não precisa)
PRECIM_CHROMIUM_PATH=
# PRECIM_BACKUP_HOST_DIR=   # pasta do host montada em /data/backups (padrão ./backups)
# PRECIM_BACKUP_KEEP=7
